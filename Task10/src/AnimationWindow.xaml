<Window x:Class="src.AnimationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:src"
        Title="Animation Demo" Height="350" Width="525">
	<StackPanel>
		<local:ImageStateControl x:Name="FanControl" Width="200" Height="200"/>
		<TextBox x:Name="IntervalTextBox" Text="1000"/>
		<Button x:Name="ApplyButton" Content="Применить" Click="ApplyButton_Click"/>
		<Button x:Name="StartStopButton" Content="Старт/Стоп" Click="StartStopButton_Click"/>
	</StackPanel>
</Window>